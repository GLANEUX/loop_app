{
  "expo": {
    "name": "loop",
    "slug": "loop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/icon-brand-plain.png",
    "scheme": "loop",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#CE3C51",
        "foregroundImage": "./assets/images/logo/icon-white.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.loop"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/full-white.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#CE3C51",
          "dark": {
            "backgroundColor": "#010C13"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a0b42d2-fa33-4686-a765-7e463f823e1f"
      }
    }
  }
}
